{
  "name": "pi-hooks",
  "version": "1.0.5",
  "description": "Collection of pi extensions (checkpoint, lsp, permission, ralph-loop, repeat)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "keywords": ["pi-package", "pi", "pi-coding-agent"],
  "scripts": {
    "install:all": "pnpm install",
    "typecheck": "pnpm -r --filter=!pi-hooks typecheck",
    "typecheck:lsp": "pnpm -C lsp run typecheck",
    "typecheck:checkpoint": "pnpm -C checkpoint run typecheck",
    "typecheck:permission": "pnpm -C permission run typecheck",
    "typecheck:ralph": "pnpm -C ralph-loop run typecheck",
    "typecheck:repeat": "pnpm -C repeat run typecheck",
    "typecheck:token-rate": "pnpm -C token-rate run typecheck",
    "test": "pnpm -C checkpoint test && pnpm -C permission test && pnpm -C lsp run test:all && pnpm -C ralph-loop test",
    "smoke-import": "tsx scripts/smoke-import.ts"
  },
  "dependencies": {
    "shell-quote": "^1.8.3",
    "vscode-languageserver-protocol": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./checkpoint/checkpoint.ts",
      "./lsp/lsp.ts",
      "./lsp/lsp-tool.ts",
      "./permission/permission.ts",
      "./ralph-loop/ralph-loop.ts",
      "./repeat/repeat.ts",
      "./token-rate/token-rate.ts"
    ]
  }
}
